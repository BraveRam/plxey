# Main server
BOT_TOKEN=
DATABASE_URL=
AI_GATEWAY_API_KEY=
PUBLIC_URL=
ENCRYPTION_KEY=
WORKER_URL=http://localhost:3001
# Origin of the owner Mini App (Vercel URL in prod, http://localhost:5173 in
# dev). Used for the CORS allowlist on /api/* and the onboarding bot's chat
# menu "Manage" button. Leave unset to disable both.
MINIAPP_ORIGIN=
# Optional: stable secret token verified against `X-Telegram-Bot-Api-Secret-Token`
# on /webhook/onboarding. If unset, a random one is generated each process start
# (fine in dev, set this in prod so the secret survives restarts/deploys).
ONBOARDING_WEBHOOK_SECRET=

# Backblaze B2 (used by main server + RAG worker)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=

# RAG worker (worker/src/server.ts)
RAG_PORT=3001
EMBEDDING_MODEL=openai/text-embedding-3-small
INNGEST_DEV=1

# Upstash Redis (REST). Used for per-customer rate limiting on business
# messages and for the "missing can_reply" owner-alert cooldown. Required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog product analytics. When unset, all PostHog calls are no-ops
# (dev environments stay silent). Default host is US cloud.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
